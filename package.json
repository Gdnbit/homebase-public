{
  "name": "homebase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HomeBase 控制面板 - 本机 12 阶段产出的统一桌面外壳",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:asr": "node scripts/test-model-recommender.mjs && node scripts/test-asr-portability.mjs",
    "test:preflight": "node scripts/check-tauri-versions.mjs && node scripts/test-preflight-banner.mjs",
    "test:preflight:native": "node scripts/test-sops-preflight.mjs",
    "test:preflight:ui": "playwright test --config playwright.ai-control.config.ts preflight.spec.ts",
    "test:secrets": "node scripts/test-secret-lifecycle.mjs",
    "test:secrets:native": "node scripts/test-secret-lifecycle-native.mjs",
    "test:secrets:ui": "playwright test --config playwright.secret-lifecycle.config.ts",
    "hb": "node scripts/homebase.mjs",
    "privacy:check": "node scripts/check-public-privacy.mjs",
    "control:generate": "node scripts/generate-control-contract.mjs",
    "control:check": "node scripts/generate-control-contract.mjs --check",
    "test:control": "node scripts/run-control-tests.mjs",
    "test:control:contract": "node --test scripts/test-interface-contract.mjs scripts/test-control-result.mjs",
    "test:control:live": "node scripts/test-docs-takeover-live.mjs --isolated-only",
    "test:queries": "node --test scripts/test-control-result.mjs",
    "test:queries:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib query_safety -- --test-threads=1",
    "test:credential-refs": "cargo test --locked --manifest-path evals/secret-lifecycle/Cargo.toml --lib dpapi_bridge -- --test-threads=1",
    "test:control:ui": "playwright test --config playwright.ai-control.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "pretauri:dev": "cargo build --locked --manifest-path src-tauri/Cargo.toml --no-default-features --bin homebase-reveal",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bundle:prepare": "pwsh -NoProfile -File scripts/prepare-windows-bundle.ps1",
    "package:windows": "pwsh -NoProfile -File scripts/package-windows.ps1",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "@lobehub/icons": "5.22.0",
    "@tanstack/react-query": "^5.62.7",
    "@tauri-apps/api": "~2.12.5",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-notification": "~2.8.1",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-shell": "~2.6.0",
    "@tauri-apps/plugin-sql": "~2.6.0",
    "@tauri-apps/plugin-store": "~2.5.1",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7"
  },
  "overrides": {
    "@lobehub/ui": "5.20.3",
    "minimatch@>=7 <11.0.1": "11.0.1",
    "katex": "0.18.10",
    "postcss-selector-parser@<6.1.5": "6.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
